[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/x-executable;application/x-iso9660-appimage;
Actions=createDesktopShortcut
X-KDE-Priority=TopLevel
X-KDE-Submenu=XNL Ft. Functions

[Desktop Action createDesktopShortcut]
Name=Create Sudo Launcher (Shortcut)
Icon=application-x-desktop
Exec=bash -c 'target="%f"; dir="$(dirname "$target")"; name="(SUDO) $(basename "$target")"; dest="$dir/$name.desktop"; cat << EOF > "$dest"\n[Desktop Entry]\nType=Application\nName=$name\nExec="$target"\nIcon=preferences-system-windows-effect-dimscreen\nTerminal=false\nX-KDE-SubstituteUID=true\nEOF\nchmod +x "$dest"'
